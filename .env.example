# Copia este archivo a .env (en el servidor) y rellénalo. .env nunca se sube a git.
POSTGRES_PASSWORD=cambia-esto
# Token compartido entre Fredy y el scorer (openssl rand -hex 24)
ARRIENDO_TOKEN=cambia-esto
# Dirección con la que abres la página de mapa y ranking; va en los avisos
ARRIENDO_WEB_URL=http://IP-DEL-SERVIDOR:8000
# Bot creado con @BotFather y tu chat (escríbele al bot y mira getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Páginas que lee Fredy por búsqueda en cada pasada (21 inmuebles cada una, más recientes primero)
FINCARAIZ_MAX_PAGES=1
FREDY_BASE_URL=http://IP-DEL-SERVIDOR:9998
# Correos de alerta de los portales (opcional). En Gmail: Cuenta > Seguridad > Contraseñas de
# aplicación. Solo se lee; no se marca ni borra nada.
IMAP_USER=
IMAP_PASSWORD=
